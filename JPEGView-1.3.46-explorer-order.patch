+
+// Reads a one-time snapshot on a private COM STA. No Shell COM call runs on the
+// UI thread, and the worker never keeps a dialog/window-object pointer.
+class CExplorerOrderSnapshot {
+public:
+	enum Status { Pending, Ready, Unavailable };
+	CExplorerOrderSnapshot() = default;
+	~CExplorerOrderSnapshot();
+	CExplorerOrderSnapshot(const CExplorerOrderSnapshot&) = delete;
+	CExplorerOrderSnapshot& operator=(const CExplorerOrderSnapshot&) = delete;
+
+	// sourceWindow must be captured before JPEGView takes foreground focus.
+	bool Start(const std::wstring& imagePath, HWND sourceWindow);
+	Status Poll(std::vector<std::wstring>& paths);
+	bool IsPending() const { return m_state != nullptr; }
+	void Cancel();
+
+private:
+	struct State;
+	std::shared_ptr<State> m_state;
+	static void Read(const std::shared_ptr<State>& state);
+};
diff --git a/src/JPEGView/ExplorerOrderPolicy.h b/src/JPEGView/ExplorerOrderPolicy.h
new file mode 100644
index 0000000..43a5ded
--- /dev/null
+++ b/src/JPEGView/ExplorerOrderPolicy.h
@@ -0,0 +1,33 @@
+#pragma once
+#include <cwchar>
+#include <list>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace ExplorerOrderPolicy {
+	struct PathLess {
+		bool operator()(const std::wstring& a, const std::wstring& b) const {
+			// Match CFileList::FindFile's case-insensitive CRT path semantics.
+			return _wcsicmp(a.c_str(), b.c_str()) < 0;
+		}
+	};
+
+	// Move existing nodes, never reconstruct file descriptors or invalidate their
+	// iterators. Items absent from the opening snapshot remain at the end, in
+	// their existing order (e.g. newly created files on a later directory reload).
+	template<class Entry, class GetPath>
+	void Reorder(std::list<Entry>& files, const std::vector<std::wstring>& snapshot, GetPath getPath) {
+		std::map<std::wstring, typename std::list<Entry>::iterator, PathLess> index;
+		for (auto i = files.begin(); i != files.end(); ++i) index.emplace(getPath(*i), i);
+		std::list<Entry> ordered;
+		for (const auto& path : snapshot) {
+			auto found = index.find(path);
+			if (found == index.end()) continue;
+			ordered.splice(ordered.end(), files, found->second);
+			index.erase(found); // duplicate entries in a Shell result are harmless
+		}
+		ordered.splice(ordered.end(), files);
+		files.swap(ordered);
+	}
+}
