cmake_minimum_required(VERSION 3.24)
foreach(_required JPEGVIEW_SOURCE_DIR JPEGVIEW_OUTPUT_DIR JPEGVIEW_CODEC_BIN_SUBDIR)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "StageRuntime requires ${_required}")
    endif()
endforeach()
if(NOT IS_DIRECTORY "${JPEGVIEW_SOURCE_DIR}/src/JPEGView/Config")
    message(FATAL_ERROR "Invalid JPEGView source directory: ${JPEGVIEW_SOURCE_DIR}")
endif()
file(MAKE_DIRECTORY "${JPEGVIEW_OUTPUT_DIR}")
file(GLOB _configs LIST_DIRECTORIES FALSE "${JPEGVIEW_SOURCE_DIR}/src/JPEGView/Config/*")
foreach(_source IN LISTS _configs)
    get_filename_component(_name "${_source}" NAME)
    set(_destination "${JPEGVIEW_OUTPUT_DIR}/${_name}")
    if(_name MATCHES "\\.ini$" AND EXISTS "${_destination}")
        continue()
    endif()
    file(COPY_FILE "${_source}" "${_destination}" ONLY_IF_DIFFERENT)
endforeach()
file(COPY_FILE "${JPEGVIEW_SOURCE_DIR}/LICENSE.txt" "${JPEGVIEW_OUTPUT_DIR}/LICENSE.txt" ONLY_IF_DIFFERENT)
foreach(_codec libjxl libheif libavif lcms2 libraw)
    file(GLOB _dlls "${JPEGVIEW_SOURCE_DIR}/src/JPEGView/${_codec}/${JPEGVIEW_CODEC_BIN_SUBDIR}/*.dll")
    if(NOT _dlls)
        message(FATAL_ERROR "Runtime DLLs missing for ${_codec}/${JPEGVIEW_CODEC_BIN_SUBDIR}")
    endif()
    foreach(_dll IN LISTS _dlls)
        get_filename_component(_name "${_dll}" NAME)
        file(COPY_FILE "${_dll}" "${JPEGVIEW_OUTPUT_DIR}/${_name}" ONLY_IF_DIFFERENT)
    endforeach()
endforeach()

# Release CRTs from Visual Studio's redistributable directory, never debug CRTs.
foreach(_runtime IN LISTS JPEGVIEW_MSVC_RUNTIME_DLLS)
    get_filename_component(_name "${_runtime}" NAME)
    file(COPY_FILE "${_runtime}" "${JPEGVIEW_OUTPUT_DIR}/${_name}" ONLY_IF_DIFFERENT)
endforeach()