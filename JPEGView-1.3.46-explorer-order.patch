diff --git a/tests/ExplorerOrderProbe.cpp b/tests/ExplorerOrderProbe.cpp
new file mode 100644
index 0000000..d3ea0cf
--- /dev/null
+++ b/tests/ExplorerOrderProbe.cpp
@@ -0,0 +1,26 @@
+#define WINVER 0x0601
+#define _WIN32_WINNT 0x0601
+#define NOMINMAX
+#include "../src/JPEGView/ExplorerOrder.h"
+#include <iostream>
+#include <cstdlib>
+
+// Read-only probe. The optional HWND lets an integration test target its own
+// Explorer window; normal usage captures the current foreground window.
+int wmain(int argc, wchar_t** argv) {
+	if (argc < 2) {
+		std::wcerr << L"Usage: ExplorerOrderProbe.exe <image-path> [Explorer-HWND-decimal] [delay-poll-ms]\n";
+		return 2;
+	}
+	HWND source = argc > 2 ? reinterpret_cast<HWND>(static_cast<ULONG_PTR>(_wcstoui64(argv[2], nullptr, 10))) : GetForegroundWindow();
+	CExplorerOrderSnapshot query;
+	if (!query.Start(argv[1], source)) { std::cout << "UNAVAILABLE:start\n"; return 3; }
+	if (argc > 3) Sleep(static_cast<DWORD>(_wtoi(argv[3])));
+	std::vector<std::wstring> paths;
+	CExplorerOrderSnapshot::Status status;
+	do { status = query.Poll(paths); if (status == CExplorerOrderSnapshot::Pending) Sleep(10); }
+	while (status == CExplorerOrderSnapshot::Pending);
+	if (status != CExplorerOrderSnapshot::Ready) { std::cout << "UNAVAILABLE\n"; return 3; }
+	for (const auto& path : paths) std::wcout << path << '\n';
+	return 0;
+}
diff --git a/tests/ExplorerOrderTests.cpp b/tests/ExplorerOrderTests.cpp
new file mode 100644
index 0000000..1674bc2
--- /dev/null
+++ b/tests/ExplorerOrderTests.cpp
@@ -0,0 +1,74 @@
+#define WINVER 0x0601
+#define _WIN32_WINNT 0x0601
+#define NOMINMAX
+#include "../src/JPEGView/ExplorerOrderPolicy.h"
+#include "../src/JPEGView/ExplorerOrder.h"
+#include <iostream>
+#include <stdexcept>
+#include <utility>
+
+namespace {
+	struct Entry {
+		std::wstring path;
+		explicit Entry(std::wstring value) : path(std::move(value)) {}
+		Entry(const Entry&) = delete; // the production descriptors must not be copied
+		Entry& operator=(const Entry&) = delete;
+	};
+	void Require(bool condition, const char* message) {
+		if (!condition) throw std::runtime_error(message);
+	}
+	std::vector<std::wstring> Paths(const std::list<Entry>& entries) {
+		std::vector<std::wstring> result;
+		for (const auto& entry : entries) result.push_back(entry.path);
+		return result;
+	}
+	void Reorder(std::list<Entry>& entries, const std::vector<std::wstring>& snapshot) {
+		ExplorerOrderPolicy::Reorder(entries, snapshot, [](const Entry& e) { return e.path; });
+	}
+}
+
+int main() {
+	try {
+		// Arbitrary view order, selected image in the middle, stable node identity.
+		std::list<Entry> files;
+		files.emplace_back(L"C:\\photos\\a.jpg");
+		files.emplace_back(L"C:\\photos\\b.jpg");
+		files.emplace_back(L"C:\\photos\\c.jpg");
+		auto selected = std::next(files.begin());
+		Entry* selectedAddress = &*selected;
+		Reorder(files, {L"C:\\photos\\c.jpg", L"C:\\photos\\b.jpg", L"C:\\photos\\a.jpg"});
+		Require(Paths(files) == std::vector<std::wstring>{L"C:\\photos\\c.jpg", L"C:\\photos\\b.jpg", L"C:\\photos\\a.jpg"}, "view order");
+		Require(&*selected == selectedAddress && selected->path == L"C:\\photos\\b.jpg", "selected image/iterator survived");
+		Require(std::prev(selected)->path == L"C:\\photos\\c.jpg" && std::next(selected)->path == L"C:\\photos\\a.jpg", "previous and next");
+		Require(files.front().path == L"C:\\photos\\c.jpg" && files.back().path == L"C:\\photos\\a.jpg", "home and end");
+
+		// Duplicate paths, missing/deleted entries, Unicode and path casing.
+		std::list<Entry> unicode;
+		unicode.emplace_back(L"C:\\Pictures\\\u732b 2.PNG");
+		unicode.emplace_back(L"C:\\Pictures\\\u732b 1.PNG");
+		unicode.emplace_back(L"C:\\Pictures\\new-A.PNG");
+		unicode.emplace_back(L"C:\\Pictures\\new-B.PNG");
+		Reorder(unicode, {L"c:\\pictures\\\u732b 1.png", L"C:\\Pictures\\deleted.PNG",
+			L"C:\\Pictures\\\u732b 1.PNG", L"c:\\pictures\\\u732b 2.png"});
+		Require(Paths(unicode) == std::vector<std::wstring>{L"C:\\Pictures\\\u732b 1.PNG", L"C:\\Pictures\\\u732b 2.PNG", L"C:\\Pictures\\new-A.PNG", L"C:\\Pictures\\new-B.PNG"}, "case/Unicode/duplicates/deletions/additions");
+		auto unchanged = Paths(unicode);
+		Reorder(unicode, {});
+		Require(Paths(unicode) == unchanged, "empty snapshot preserves fallback");
+		std::list<Entry> empty;
+		Reorder(empty, {L"C:\\missing.jpg"});
+		Require(empty.empty(), "empty folder");
+
+		CExplorerOrderSnapshot query;
+		std::vector<std::wstring> output;
+		Require(!query.Start(L"C:\\missing.jpg", nullptr), "missing origin falls back");
+		Require(!query.Start(L"C:\\missing.jpg", GetDesktopWindow()), "desktop excluded");
+		Require(query.Poll(output) == CExplorerOrderSnapshot::Unavailable, "no query pending");
+		query.Cancel();
+		query.Cancel();
+		std::cout << "PASS: view order, selected node, previous/next, home/end, Unicode, case, duplicates, deleted/new files, empty lists and no-origin fallback.\n";
+		return 0;
+	} catch (const std::exception& error) {
+		std::cerr << "FAIL: " << error.what() << '\n';
+		return 1;
+	}
+}
diff --git a/tests/SmokeExplorer.ps1 b/tests/SmokeExplorer.ps1
new file mode 100644
index 0000000..0b78f7a
--- /dev/null
+++ b/tests/SmokeExplorer.ps1
@@ -0,0 +1,56 @@
+param([string]$Compiler = 'D:\soft\CLion 2026.2.4\bin\mingw\bin\g++.exe')
+$ErrorActionPreference = 'Stop'
+$repoRoot = Split-Path $PSScriptRoot -Parent
+$binDir = Join-Path $PSScriptRoot 'bin'
+$fixtureDir = Join-Path $PSScriptRoot 'explorer-fixture'
+New-Item -ItemType Directory -Path $binDir,$fixtureDir -Force | Out-Null
+$env:PATH = (Split-Path $Compiler -Parent) + ';' + $env:PATH
+& $Compiler -std=c++17 -O2 -Wall -Wextra -Werror -DJPEGVIEW_EXPLORER_ORDER_DIAGNOSTICS -municode (Join-Path $PSScriptRoot 'ExplorerOrderProbe.cpp') (Join-Path $repoRoot 'src\JPEGView\ExplorerOrder.cpp') -o (Join-Path $binDir 'ExplorerOrderProbe.exe') -lole32 -loleaut32 -lshell32 -luuid -lshlwapi
+if ($LASTEXITCODE -ne 0) { throw 'Probe compilation failed.' }
+Add-Type -AssemblyName System.Drawing
+foreach ($spec in @(@('a-large.bmp',96),@('b-small.bmp',32),@('c-medium.bmp',64))) {
+    $bitmap = New-Object Drawing.Bitmap ([int]$spec[1]),([int]$spec[1])
+    try { $bitmap.Save((Join-Path $fixtureDir $spec[0]),[Drawing.Imaging.ImageFormat]::Bmp) }
+    finally { $bitmap.Dispose() }
+}
+$shell = New-Object -ComObject Shell.Application
+$existing = @($shell.Windows() | Where-Object { try { $_.Document.Folder.Self.Path -eq $fixtureDir } catch { $false } })
+if ($existing.Count) { throw 'Test folder is already open; close that test-folder window first.' }
+$window = $null
+$opened = $false
+$results = @()
+try {
+    Start-Process -FilePath "$env:WINDIR\explorer.exe" -ArgumentList @('/n,',('"'+$fixtureDir+'"')) -WindowStyle Hidden
+    $opened = $true
+    $deadline = [DateTime]::UtcNow.AddSeconds(12)
+    do {
+        $window = $shell.Windows() | Where-Object { try { $_.Document.Folder.Self.Path -eq $fixtureDir } catch { $false } } | Select-Object -First 1
+        if (!$window) { Start-Sleep -Milliseconds 100 }
+    } while (!$window -and [DateTime]::UtcNow -lt $deadline)
+    if (!$window) { throw 'Could not locate the isolated Explorer test folder.' }
+    $image = Join-Path $fixtureDir 'c-medium.bmp'
+    foreach ($case in @(
+        @{Name='size-ascending'; Sort='prop:+System.Size;'; Expected=@('b-small.bmp','c-medium.bmp','a-large.bmp')},
+        @{Name='name-descending'; Sort='prop:-System.ItemNameDisplay;'; Expected=@('c-medium.bmp','b-small.bmp','a-large.bmp')}
+    )) {
+        $window.Document.SortColumns = $case.Sort
+        Start-Sleep -Milliseconds 400
+        # Second case also verifies consumption after a slow first-image paint:
+        # a snapshot completed within budget must remain usable after 2 seconds.
+        $delayPoll = if ($case.Name -eq 'name-descending') { '2200' } else { '0' }
+        $lines = @(& (Join-Path $binDir 'ExplorerOrderProbe.exe') $image ([string]$window.HWND) $delayPoll)
+        if ($LASTEXITCODE -ne 0) { throw "Snapshot failed for $($case.Name): $lines" }
+        $actual = @($lines | ForEach-Object { Split-Path ([string]$_) -Leaf })
+        if (($actual -join '|') -ne ($case.Expected -join '|')) {
+            throw "Wrong order for $($case.Name) [Shell=$($window.Document.SortColumns)]: $($actual -join ', ')"
+        }
+        $results += [PSCustomObject]@{Case=$case.Name; Result='PASS'; Order=$actual; ShellSortColumns=[string]$window.Document.SortColumns; PollDelayMs=[int]$delayPoll}
+    }
+    $results | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath (Join-Path $PSScriptRoot 'explorer-smoke-result.json') -Encoding UTF8
+    $results | ConvertTo-Json -Depth 5
+} finally {
+    # Close only the window opened by this test and still showing our fixture.
+    if ($opened -and $window) {
+        try { if ($window.Document.Folder.Self.Path -eq $fixtureDir) { $window.Quit() } } catch { }
+    }
+}
